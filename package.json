{
  "name": "amazon-listing-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:start && npm run db:migrate && next dev --hostname 0.0.0.0",
    "dev:app": "next dev --hostname 0.0.0.0",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:backfill-images": "node --env-file-if-exists=.env --import tsx scripts/backfill-images.ts",
    "db:revalidate": "node --env-file-if-exists=.env --import tsx scripts/revalidate-listings.ts",
    "ocr:eval": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/eval-ocr.ts",
    "ai:eval": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/eval-generation.ts",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
