<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amazon.disbursements.crawler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ad/mac-crawler/run_disbursements_weekly.sh</string>
    </array>

    <!-- Chạy tự động lúc 04:30 sáng Thứ Hai hàng tuần (Weekday 1: Thứ 2 trong launchd) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/ad/Library/Logs/mac-disbursements.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ad/Library/Logs/mac-disbursements.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/ad/mac-crawler</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/ad</string>
    </dict>
</dict>
</plist>
