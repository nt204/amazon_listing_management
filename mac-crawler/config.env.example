# ADSPOWER_CDP_PORT=
DOWNLOAD_BASE_DIR=$HOME/Downloads/Bulk file

R2_ACCOUNT_ID=
R2_BUCKET_NAME=amazon-listing-production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PPC_R2_PREFIX=ppc-reports

WEB_APP_URL=https://ncehub.net
WEB_APP_AUTH_TOKEN=

# CẤU HÌNH TIMEOUT & RESILIENCE STATE MACHINE
AMAZON_REPORT_TIMEOUT_MINUTES=30
AMAZON_REPORT_POLL_SECONDS=12
REPORT_DOWNLOAD_TIMEOUT_MINUTES=15
CRAWLER_JOB_TIMEOUT_MINUTES=120
WORKER_HEARTBEAT_SECONDS=15
# Lease do Web App quản lý bằng PPC_CRAWLER_LEASE_SECONDS (mặc định 90s).

# Retry có giới hạn. File/checkpoint thành công sẽ được tái sử dụng ở lần sau.
CRAWLER_MAX_JOB_ATTEMPTS=3
ADSPOWER_MAX_ATTEMPTS=3
AMAZON_REPORT_MAX_RECREATE=2
DOWNLOAD_MAX_ATTEMPTS=3
R2_UPLOAD_MAX_ATTEMPTS=5
DB_SYNC_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=5
