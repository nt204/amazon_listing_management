STORE_NAME=HSOSTORE
ADSPOWER_PROFILE_ID=
ADSPOWER_API_URL=http://127.0.0.1:50325
ADSPOWER_APP_START_TIMEOUT_SECONDS=60
# ADSPOWER_CDP_PORT=
# LaunchAgent bị macOS TCC chặn Desktop/Downloads. Dùng đường dẫn không có dấu cách
# để config.env có thể được source an toàn bởi bash.
DOWNLOAD_BASE_DIR=$HOME/AmazonPpcCrawler/downloads

R2_ACCOUNT_ID=
R2_BUCKET_NAME=amazon-listing-production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PPC_R2_PREFIX=ppc-reports

WEB_APP_URL=https://ncehub.net
WEB_APP_AUTH_TOKEN=

# CẤU HÌNH TIMEOUT & RESILIENCE STATE MACHINE
AMAZON_REPORT_TIMEOUT_MINUTES=30
AMAZON_REPORT_POLL_SECONDS=12
REPORT_DOWNLOAD_TIMEOUT_MINUTES=15
CRAWLER_JOB_TIMEOUT_MINUTES=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_POLL_SECONDS=10
WORKER_REQUEST_TIMEOUT_SECONDS=20
SCHEDULE_STORE_ENQUEUE_MAX_ATTEMPTS=3
SCHEDULE_STORE_ENQUEUE_RETRY_SECONDS=30
# Lease do Web App quản lý bằng PPC_CRAWLER_LEASE_SECONDS (mặc định 90s).

# Retry có giới hạn. File/checkpoint thành công sẽ được tái sử dụng ở lần sau.
CRAWLER_MAX_JOB_ATTEMPTS=3
ADSPOWER_MAX_ATTEMPTS=3
AMAZON_REPORT_MAX_RECREATE=2
DOWNLOAD_MAX_ATTEMPTS=3
R2_UPLOAD_MAX_ATTEMPTS=5
DB_SYNC_MAX_ATTEMPTS=5
# Thời gian Mac theo dõi ingestion job nền trên server; không phải HTTP timeout.
DB_SYNC_TIMEOUT_MINUTES=120
RETRY_BASE_DELAY_SECONDS=5

# Giới hạn tài nguyên và tự dọn dẹp an toàn trên Mac mini
MIN_FREE_DISK_GB=10
MAX_LOG_MB=20
LOG_RETENTION_DAYS=14
LOCAL_RETENTION_DAYS=14
CHECKPOINT_RETENTION_DAYS=30
# ID ổn định qua mỗi lần restart; nếu bỏ trống sẽ dùng hostname.
WORKER_ID=

# Tên ứng dụng macOS dùng cho lệnh `open -a` khi AdsPower chưa chạy.
ADSPOWER_APP_NAME=AdsPower Global

# File Bulk do server tạo sẽ được tải tạm vào inbox, sau đó chuyển sang completed/failed.
# Mặc định: $HOME/AmazonPpcCrawler/bulk-upload
BULK_UPLOAD_DIR=$HOME/AmazonPpcCrawler/bulk-upload

# ============================================================
# CẤU HÌNH THÔNG BÁO TELEGRAM (BOT BÁO TIẾN ĐỘ & SỰ CỐ)
# ============================================================
TELEGRAM_BOT_TOKEN=7319056820:AAGnHjcTzqWlS6QU4OjEiP3mPnXCejGnXqw
TELEGRAM_CHAT_ID=-1002462247213
TELEGRAM_TOPIC_ID=1792
# Proxy Cloudflare Worker chống chặn mạng (tùy chọn, để trống nếu gọi thẳng api.telegram.org)
TELEGRAM_PROXY_URL=https://nce-telegram-proxy.ntthanhnce.workers.dev
