<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amazon.inventory.crawler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/macbook/Desktop/Amazon Listing Management/mac-crawler/run_inventory_weekly.sh</string>
    </array>

    <!-- Chạy tự động lúc 04:00 sáng Thứ Hai hàng tuần để chốt tồn kho Thứ Bảy tuần trước,
         và 04:00 sáng mùng 1 hằng tháng để chốt tồn kho ngày cuối tháng trước -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>4</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Day</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>4</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/macbook/Library/Logs/mac-inventory.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/macbook/Library/Logs/mac-inventory.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/macbook/Desktop/Amazon Listing Management/mac-crawler</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/macbook</string>
    </dict>
</dict>
</plist>
