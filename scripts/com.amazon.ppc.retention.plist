<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.amazon.ppc.retention</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>set -a; source /Users/ad/AmazonPpcCrawler/config.env; set +a; PPC_R2_KEEP_DAYS=3 PPC_ARCHIVE_ROOT=/Users/ad/AmazonPpcCrawler/downloads /Users/ad/AmazonPpcCrawler/node_modules/.bin/tsx /Users/ad/AmazonPpcCrawler/ppc-r2-retention.ts --apply</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ad/Library/Logs/ppc-retention.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ad/Library/Logs/ppc-retention.log</string>
</dict>
</plist>
