# AI providers. Configure at least one key for real generation.
PORT=2411
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=
# CheapKeyAI gateway. Glass Ornament Template Mockup requires this key.
CHEAPKEYAI_API_KEY=
CHEAPKEYAI_BASE_URL=https://cheapkeyai.shop/v1
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-5.6-terra
# Mockup image generation (server-side only). Also supports gpt-image-2-c, gpt-image-2, and gpt-image-1.5.
MOCKUP_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT_MS=600000
# Applies only to direct OpenAI image requests. CheapKeyAI requests never use
# SDK retries because its gateway already performs upstream channel routing.
OPENAI_IMAGE_RETRY_ATTEMPTS=1
# PNG/transparent sources remain PNG; photographic sources use high-quality JPEG.
MOCKUP_INPUT_MAX_DIMENSION=1536
# Up to 5 products enter the pipeline. CheapKeyAI uses 3 calls per product;
# Redis keeps at most 6 provider image calls active globally for the whole team.
IMAGE_GENERATION_CONCURRENCY=6
MOCKUP_MAX_ACTIVE_PRODUCTS=5
MOCKUP_MAX_GLOBAL_IMAGE_REQUESTS=6
# CheapKeyAI uses one shared gateway key, so cap the whole team at 3 concurrent calls.
MOCKUP_MAX_CHEAPKEYAI_IMAGE_REQUESTS=3
# Large PNG uploads are slower than AI responses on some connections. Keep only
# two Trello uploads active across the whole team to avoid saturating bandwidth.
MOCKUP_MAX_TRELLO_UPLOADS=2
MOCKUP_QUEUE_TIMEOUT_MS=300000
# Durable team queue. Five workers accept jobs, while the provider/image limits
# above remain the global throughput guard across every worker/server instance.
MOCKUP_JOB_WORKER_ENABLED=true
MOCKUP_JOB_WORKER_CONCURRENCY=5
MOCKUP_JOB_MAX_ATTEMPTS=3
MOCKUP_MAX_QUEUED_JOBS_PER_TEAM=30
MOCKUP_JOB_RATE_LIMIT_PER_MINUTE=10
MOCKUP_JOB_RETENTION_DAYS=14
# Keep direct browser calls disabled in production; the internal worker is
# authenticated separately and can still call the generation engine.
ALLOW_DIRECT_MOCKUP_GENERATION=false
# Defaults to http://127.0.0.1:$PORT. Set only when the worker must call a
# different internal Next.js address.
# MOCKUP_WORKER_BASE_URL=http://127.0.0.1:2411
# Optional separate worker secret. When omitted, LISTING_DESK_SESSION_SECRET is
# used in authenticated production deployments.
# MOCKUP_WORKER_SECRET=replace-with-at-least-32-random-characters
# Glass Ornament template editor: CheapKeyAI-only; upstream model is locked to gpt-image-2.
TEMPLATE_MOCKUP_IMAGE_SIZE=2000x2000
TEMPLATE_MOCKUP_IMAGE_QUALITY=high
TEMPLATE_MOCKUP_IMAGE_TIMEOUT_MS=600000
GEMINI_IMAGE_TIMEOUT_MS=90000
GEMINI_IMAGE_RETRY_ATTEMPTS=2
GEMINI_IMAGE_CONCURRENCY=1
# ChatGPT Web Browser Automation (Playwright/Selenium)
# Cookies from chatgpt.com session (JSON array or raw "key1=val1; key2=val2" string)
CHATGPT_WEB_COOKIES=
CHATGPT_SESSION_TOKEN=
CHATGPT_WEB_HEADLESS=true

# One listing-generation request; Gemini is preferred and OpenAI is fallback.
AI_TIMEOUT_MS=45000
AI_MOCK_MODE=true

# Optional Search Volume research through the Helium 10 MCP server.
HELIUM10_MCP_URL=https://mcp.helium10.com/mcp
# HELIUM10_MCP_ACCESS_TOKEN=
# HELIUM10_MOCK_MODE=true
HELIUM10_REQUIRED=false
HELIUM10_CONNECT_TIMEOUT_MS=20000
HELIUM10_TOOL_TIMEOUT_MS=45000
HELIUM10_CACHE_TTL_MS=21600000
HELIUM10_RATE_LIMIT_PER_MINUTE=10

# Deterministic server-side OCR. English trained data is bundled with the app.
LOCAL_OCR_ENABLED=true
LOCAL_OCR_LANGUAGE=eng
# Optional override. By default the rule profile runs AUTO + SPARSE_TEXT.
# LOCAL_OCR_PAGE_SEGMENTATION_MODE=AUTO
LOCAL_OCR_TIMEOUT_MS=30000
LOCAL_OCR_MAX_IMAGES=10
# Optional confidence overrides; defaults live in the listing profile.
# LOCAL_OCR_MIN_WORD_CONFIDENCE=20
# LOCAL_OCR_MIN_LINE_CONFIDENCE=20
# For another language, install/provide its trained data directory and set:
# LOCAL_OCR_LANGUAGE_PATH=/absolute/path/to/traineddata-directory
# LOCAL_OCR_LANGUAGE_GZIP=true

# Versioned listing rules. Use LISTING_RULES_JSON only for a complete registry override.
LISTING_RULE_PROFILE=amazon-pod
# LISTING_RULES_JSON=

# Optional Amazon reference reader.
COMPETITOR_READER_URL=https://r.jina.ai/http://
COMPETITOR_TIMEOUT_MS=3500
COMPETITOR_CACHE_TTL_MS=21600000
COMPETITOR_MAX_CHARS=6000

DATABASE_URL=postgresql://listing_desk:listing_desk@localhost:2412/listing_desk
REDIS_URL=redis://localhost:2413
# Trello uploads can take longer than ordinary card/list requests.
TRELLO_REQUEST_TIMEOUT_MS=120000
# Lightweight Trello display derivatives are removed after this many days.
TRELLO_PREVIEW_RETENTION_DAYS=90
# /api/health and npm run db:maintain report warning/critical disk pressure.
DISK_WARNING_PERCENT=70
DISK_CRITICAL_PERCENT=80
# Defaults to the app working directory. Set this to the mounted data filesystem on production.
# DISK_MONITOR_PATH=/var/lib/listing-desk
# Source/master uploads are retained byte-for-byte. AI receives a separate 1600px derivative.
# Trello mockup masters remain on Trello; PostgreSQL stores only 1280px/320px WebP display derivatives.
MAX_IMAGE_BYTES=15000000
MAX_TOTAL_IMAGE_BYTES=50000000
# Includes Base64 overhead for the source images above.
MAX_REQUEST_BYTES=75000000
MAX_SYNC_BATCH_ITEMS=4
AI_RATE_LIMIT_PER_MINUTE=10
IDEMPOTENCY_RETENTION_HOURS=24

# Excel automation. Python 3 + requirements.txt are required on the app server.
PYTHON_BIN=python3

# MVP default: single internal workspace without login. Do not expose this mode publicly.
LISTING_DESK_AUTH_MODE=disabled
# To enable team tokens later, set mode=required and configure the following values.
# LISTING_DESK_SESSION_SECRET=replace-with-at-least-32-random-characters
# LISTING_DESK_TEAMS_JSON=[{"team_id":"team-a","user_id":"admin","display_name":"Admin","token":"replace-with-at-least-24-characters","role":"admin","rule_profile":"amazon-pod"}]
# LISTING_DESK_ALLOWED_ORIGINS=https://listing.example.com

# Trello Integration (Optional: can also be configured in UI)
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here
TRELLO_BOARD_ID=hcmdsBOh
TRELLO_INTERNAL_REVIEW_LIST=TEAM DUYỆT NỘI BỘ
TRELLO_LISTING_LIST=Listing
